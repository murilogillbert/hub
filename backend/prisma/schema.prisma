// OpenDriverHub — schema Postgres (Supabase). Porta 1:1 o modelo do antigo
// AppDbContext.cs (EF Core / SQL Server): mesmas entidades, relações,
// cascades e índices. Nomes de coluna/tabela em snake_case (idiomático em
// Postgres/Supabase); o Prisma Client continua expondo camelCase no código.

generator client {
  provider      = "prisma-client-js"
  // "native" para rodar local (Windows/Mac/Linux); "rhel-openssl-3.0.x" é o
  // binário que as funções serverless da Vercel (Amazon Linux) precisam.
  // Sem isso, o Prisma Client falha em runtime na Vercel com "Query Engine
  // not found for this platform".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  Client
  Partner
  Admin
  Financeiro
}

/// Distingue lojas do marketplace de afiliados do programa solar — mesma
/// entidade Partner, comportamento e telas diferentes por tipo.
enum PartnerKind {
  Marketplace
  SolarAffiliate
}

enum CommissionEntryType {
  Credit
  Debit
}

enum WithdrawalStatus {
  Pending
  Approved
  Rejected
  Paid
}

enum ApplicationStatus {
  Pending
  Approved
  Rejected
}

enum PixKeyType {
  CPF
  CNPJ
  Email
  Phone
  Random
}

enum AuthTokenPurpose {
  EmailVerification
  PasswordReset
}

enum ProductKind {
  Physical
  Digital
  Voucher
}

enum OrderStatus {
  PendingPayment
  Paid
  Redeemed
  Cancelled
}

enum PaymentStatus {
  Pending
  Approved
  Rejected
  Cancelled
  Refunded
}

enum PaymentMethod {
  Pix
  CreditCard
  DebitCard
}

enum CategoryType {
  Product
  Store
}

enum LeadTemperature {
  Frio
  Morno
  Quente
}

enum CashbackEntryType {
  Earned
  Used
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String    @db.VarChar(160)
  email           String    @unique @db.VarChar(180)
  passwordHash    String    @map("password_hash")
  role            UserRole  @default(Client)
  cashbackBalance Decimal   @default(0) @db.Decimal(12, 2) @map("cashback_balance")
  avatarUrl       String?   @map("avatar_url")
  phone           String?
  notifyWhatsApp  Boolean   @default(true) @map("notify_whatsapp")
  notifyEmail     Boolean   @default(true) @map("notify_email")
  notifyPromo     Boolean   @default(false) @map("notify_promo")
  cpf             String?   @db.VarChar(20)
  emailVerifiedAt DateTime? @map("email_verified_at")
  partnerId       String?   @map("partner_id") @db.Uuid
  partner         Partner?  @relation(fields: [partnerId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  orders          Order[]
  cashbackEntries CashbackEntry[]
  reviews         Review[]
  authTokens      AuthToken[]

  @@map("users")
}

/// Token de uso único para verificação de e-mail e redefinição de senha.
/// Guardamos só o hash (SHA-256) — o token bruto nunca é persistido, só sai
/// no link do e-mail.
model AuthToken {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("auth_tokens")
}

model Partner {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String         @db.VarChar(160)
  segment        String
  logoUrl        String         @default("") @map("logo_url")
  cnpj           String         @default("")
  city           String         @default("")
  state          String         @default("")
  lat            Float          @default(0)
  lng            Float          @default(0)
  active         Boolean        @default(true)
  feePercent     Decimal        @default(10) @db.Decimal(5, 2) @map("fee_percent")
  /// Carteira do parceiro no Asaas (walletId). Quando presente, o pagamento é
  /// dividido (split) e o líquido cai direto na conta dele.
  asaasWalletId  String?        @map("asaas_wallet_id") @db.VarChar(64)
  /// Nome da instância do afiliado no Evolution API (WhatsApp self-hosted) —
  /// usada pelo energia-solar-api pra mandar a proposta em PDF pelo WhatsApp
  /// do próprio consultor. Preenchido pelo próprio afiliado ao parear o
  /// WhatsApp (ver whatsappConnectService.ts), ou manualmente pelo Admin.
  evolutionInstance String?     @map("evolution_instance") @db.VarChar(120)
  joinedAt       DateTime       @default(now()) @map("joined_at")

  /// Programa de afiliados solar (kind = SolarAffiliate) — não usado por lojas.
  kind               PartnerKind @default(Marketplace)
  referralCode       String?     @unique @map("referral_code")
  commissionBalance  Decimal     @default(0) @db.Decimal(12, 2) @map("commission_balance")
  linkViews          Int         @default(0) @map("link_views")
  linkLeads          Int         @default(0) @map("link_leads")
  linkSales          Int         @default(0) @map("link_sales")
  /// Conta especial operada por integração (bot próprio), sem usuário humano.
  ownedByCompany     Boolean     @default(false) @map("owned_by_company")
  /// Chave Pix padrão do afiliado, reaproveitada em todo pedido de saque.
  pixKey             String?     @map("pix_key")
  pixKeyType         PixKeyType? @map("pix_key_type")

  users              User[]
  products           Product[]
  stores             PartnerStore[]
  orderItems         OrderItem[]
  payouts            PartnerPayout[]
  commissionEntries  AffiliateCommissionEntry[]
  withdrawalRequests WithdrawalRequest[]

  @@map("partners")
}

model PartnerStore {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name      String
  address   String
  city      String   @db.VarChar(120)
  state     String   @db.VarChar(40)
  lat       Float
  lng       Float
  category  String
  imageUrl  String   @default("") @map("image_url")

  @@map("partner_stores")
}

/// Categoria de produto ou de loja — definida e gerida pelo Admin.
model Category {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(80)
  type      CategoryType @default(Product)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([name, type])
  @@map("categories")
}

model Product {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId        String      @map("partner_id") @db.Uuid
  partner          Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title            String      @db.VarChar(200)
  description      String
  price            Decimal     @db.Decimal(12, 2)
  cashbackPercent  Decimal     @db.Decimal(5, 2) @map("cashback_percent")
  kind             ProductKind
  imageUrl         String      @default("") @map("image_url")
  category         String      @default("")
  rating           Float       @default(0)
  stock            Int         @default(0)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at")
  orderItems       OrderItem[]
  reviews          Review[]

  @@index([partnerId])
  @@map("products")
}

model Order {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String              @unique @db.VarChar(40)
  customerId        String              @map("customer_id") @db.Uuid
  customer          User                @relation(fields: [customerId], references: [id])
  paidPrice         Decimal             @default(0) @db.Decimal(12, 2) @map("paid_price")
  cashbackEarned    Decimal             @default(0) @db.Decimal(12, 2) @map("cashback_earned")
  cashbackUsed      Decimal             @default(0) @db.Decimal(12, 2) @map("cashback_used")
  status            OrderStatus         @default(PendingPayment)
  paymentMethod     PaymentMethod?      @map("payment_method")
  paymentReference  String?             @map("payment_reference")
  externalPaymentId String?             @map("external_payment_id")
  voucherCode       String?             @map("voucher_code")
  createdAt         DateTime            @default(now()) @map("created_at")
  paidAt            DateTime?           @map("paid_at")
  redeemedAt        DateTime?           @map("redeemed_at")
  items             OrderItem[]
  payments          PaymentTransaction[]
  cashbackEntries   CashbackEntry[]
  reviews           Review[]

  @@index([customerId, status])
  @@map("orders")
}

/// Item de um pedido. Cada item pertence a um parceiro; o resgate é feito
/// por parceiro (cada parceiro resgata só os seus itens do voucher).
model OrderItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String    @map("product_id") @db.Uuid
  product         Product   @relation(fields: [productId], references: [id])
  partnerId       String    @map("partner_id") @db.Uuid
  partner         Partner   @relation(fields: [partnerId], references: [id])
  productTitle    String    @db.VarChar(200) @map("product_title") // snapshot
  imageUrl        String    @default("") @map("image_url")          // snapshot
  category        String    @default("")                            // snapshot
  unitPrice       Decimal   @db.Decimal(12, 2) @map("unit_price")
  quantity        Int       @default(1)
  cashbackPercent Decimal   @db.Decimal(5, 2) @map("cashback_percent")
  lineTotal       Decimal   @db.Decimal(12, 2) @map("line_total")
  cashbackEarned  Decimal   @db.Decimal(12, 2) @map("cashback_earned")
  redeemedAt      DateTime? @map("redeemed_at")

  @@index([orderId])
  @@index([partnerId])
  @@map("order_items")
}

model PaymentTransaction {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("mock")
  externalReference String?       @map("external_reference")
  externalPaymentId String?       @map("external_payment_id")
  method            PaymentMethod
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus
  statusDetail      String?       @map("status_detail")
  responsePayload   String?       @map("response_payload")
  createdAt         DateTime      @default(now()) @map("created_at")
  lastSyncedAt      DateTime?     @map("last_synced_at")

  @@index([externalPaymentId])
  @@map("payment_transactions")
}

model CashbackEntry {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?           @map("order_id") @db.Uuid
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        CashbackEntryType
  amount      Decimal           @db.Decimal(12, 2)
  description String            @db.VarChar(240)
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("cashback_entries")
}

/// Avaliação de um produto por um cliente que já resgatou.
model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  orderId   String   @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int // 1..5
  comment   String   @default("") @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, userId])
  @@map("reviews")
}

model AssistantLead {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?           @map("user_id") @db.Uuid
  profile      String?
  category     String?
  goal         String?
  mainIntent   String?           @map("main_intent")
  score        Int               @default(0)
  temperature  LeadTemperature   @default(Frio)
  createdAt    DateTime          @default(now()) @map("created_at")
  interactions BotInteraction[]

  @@map("assistant_leads")
}

model BotInteraction {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId       String?         @map("lead_id") @db.Uuid
  lead         AssistantLead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userMessage  String          @map("user_message")
  botResponse  String          @map("bot_response")
  step         String          @default("")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@map("bot_interactions")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  message   String
  channel   String    @default("interno")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

/// Evento de webhook de pagamento recebido (rastreabilidade + dedupe).
model PaymentEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String   @default("mercado_pago")
  eventType    String   @map("event_type")
  externalId   String?  @map("external_id")
  orderId      String?  @map("order_id") @db.Uuid
  status       String
  rawPayload   String?  @map("raw_payload")
  processedAt  DateTime @default(now()) @map("processed_at")

  @@map("payment_events")
}

/// Credencial/configuração de integração editável em runtime. Quando
/// presente, sobrepõe o valor do .env.
model IntegrationSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(120)
  value     String   @db.VarChar(1024)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("integration_settings")
}

/// Repasse (pagamento) lançado pelo admin a um parceiro, referente a um
/// período do que foi resgatado. É o que define o "Recebido" do parceiro.
model PartnerPayout {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId   String   @map("partner_id") @db.Uuid
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  note        String   @default("") @db.VarChar(400)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([partnerId, createdAt])
  @@map("partner_payouts")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  payloadJson String?  @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

/// Lançamento no livro-caixa de comissão de um afiliado (espelha CashbackEntry).
/// externalReference garante idempotência quando outro sistema (energia-solar-api)
/// credita/debita via API de serviço — reenvios do n8n não duplicam o lançamento.
model AffiliateCommissionEntry {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId         String              @map("partner_id") @db.Uuid
  partner           Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type              CommissionEntryType
  amount            Decimal             @db.Decimal(12, 2)
  description       String              @db.VarChar(240)
  externalReference String?             @unique @map("external_reference")
  createdBy         String?             @map("created_by") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([partnerId, createdAt])
  @@map("affiliate_commission_entries")
}

/// Pedido de saque de um afiliado — autoatendimento + aprovação do financeiro.
model WithdrawalRequest {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId   String            @map("partner_id") @db.Uuid
  partner     Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount      Decimal           @db.Decimal(12, 2)
  status      WithdrawalStatus  @default(Pending)
  note        String            @default("") @db.VarChar(400)
  /// Snapshot da chave Pix usada neste saque (pode ser a do perfil do
  /// afiliado ou uma informada só para esta solicitação) — auditoria do
  /// financeiro mesmo que o afiliado troque a chave depois.
  pixKey      String?           @map("pix_key")
  pixKeyType  PixKeyType?       @map("pix_key_type")
  requestedAt DateTime          @default(now()) @map("requested_at")
  resolvedAt  DateTime?         @map("resolved_at")
  resolvedBy  String?           @map("resolved_by") @db.Uuid

  @@index([partnerId, requestedAt])
  @@map("withdrawal_requests")
}

/// Biblioteca de materiais de campanha (arquivos) disponível a todo afiliado ativo.
model CampaignMaterial {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.VarChar(160)
  description String   @default("")
  fileUrl     String   @map("file_url")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("campaign_materials")
}

/// Inscrição pública "quero ser afiliado" — aprovada pelo Admin, que então cria
/// User+Partner(kind=SolarAffiliate) e envia e-mail de boas-vindas.
model AffiliateApplication {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String             @db.VarChar(160)
  email      String             @db.VarChar(180)
  phone      String             @default("")
  city       String             @default("")
  state      String             @default("")
  message    String             @default("")
  status     ApplicationStatus  @default(Pending)
  createdAt  DateTime           @default(now()) @map("created_at")
  resolvedAt DateTime?          @map("resolved_at")
  resolvedBy String?            @map("resolved_by") @db.Uuid

  @@index([status, createdAt])
  @@map("affiliate_applications")
}

/// Chave de API para integrações servidor-a-servidor (n8n, energia-solar-api, ...)
/// chamando as rotas /api/v1/service/*. Nunca guardamos a chave em texto puro.
model ServiceApiKey {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label      String    @db.VarChar(120)
  hashedKey  String    @unique @map("hashed_key")
  /// prefixo exibido na UI pra identificar a chave sem guardar o valor completo.
  keyPreview String    @map("key_preview") @db.VarChar(16)
  scopes     String[]
  active     Boolean   @default(true)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("service_api_keys")
}
