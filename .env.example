SQLSERVER_PASSWORD=Strong_Local_Pwd_123!
SQLSERVER_PORT=1435

# ===== Pagamento =====
# Provider ativo: mock | mercadopago | asaas
Payment__Provider=mock

# ===== Asaas (gateway com split automático) =====
# Em produção use Environment=production. As credenciais também podem ser
# definidas em Admin -> Integrações (sobrepõem estas variáveis em runtime).
Asaas__Environment=sandbox
Asaas__ApiKey=
Asaas__WebhookToken=
# CPF/CNPJ de teste usado no cliente Asaas em sandbox (PIX exige doc).
Asaas__DefaultCpfCnpj=
