# ===== Front (Vite) =====
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ===== Banco (Supabase Postgres) =====
# Crie um projeto em https://supabase.com, depois em
# Project Settings -> Database copie as duas connection strings abaixo
# (marque "Use connection pooling" para a DATABASE_URL).
#   DATABASE_URL = connection pooling (porta 6543) — usada pela API em runtime.
#   DIRECT_URL   = conexão direta (porta 5432) — usada só pelo `prisma migrate`.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# ===== Storage de imagens (Supabase Storage) =====
# Em Project Settings -> API copie a URL do projeto e a "service_role" key.
# Em Storage, crie um bucket público (ex.: "uploads") e informe o nome abaixo.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ===== Autenticação (JWT próprio, não é o Supabase Auth) =====
JWT_SECRET=troque-por-um-segredo-forte-de-32-bytes-ou-mais
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=604800

# ===== API =====
PORT=5000
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_AUTH_PERMIT=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# ===== Seed =====
# Seed:Enabled=true popula dados demo (parceiros/produtos/pedidos de exemplo).
# O admin abaixo é sempre garantido no boot, mesmo com SEED_ENABLED=false.
SEED_ENABLED=false
SEED_ADMIN_EMAIL=admin@opendriverhub.com
SEED_ADMIN_PASSWORD=Bababobo!@#

# ===== Pagamento =====
# Provider ativo: mock | mercadopago | asaas
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_REQUIRE_SIGNATURE=true
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# ===== Mercado Pago =====
# Credenciais também podem ser definidas em Admin -> Integrações (sobrepõem
# estas variáveis em runtime).
MercadoPago__AccessToken=
MercadoPago__PublicKey=
MercadoPago__WebhookSecret=

# ===== Asaas (gateway com split automático) =====
# Em produção use Environment=production.
Asaas__Environment=sandbox
Asaas__ApiKey=
Asaas__WebhookToken=
# CPF/CNPJ de teste usado no cliente Asaas em sandbox (PIX exige doc).
Asaas__DefaultCpfCnpj=
