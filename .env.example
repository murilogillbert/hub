# ===== Front (Vite) =====
VITE_API_BASE_URL=http://localhost:5000/api/v1
# API do OpenDriver (app de corridas) — telas Admin → OpenDriver. Mesmo banco e
# mesmo JWT_SECRET; a origem deste painel precisa estar no CORS_ORIGINS de lá.
VITE_OPENDRIVER_API_URL=http://localhost:5100
# API do OpenAd (anúncios em telas automotivas) — tela /conta/credito-de-anuncio,
# onde o anunciante compra crédito de veiculação por Pix. Mesmo JWT_SECRET: o
# token do hub é o que a API do OpenAd aceita na origem federada. A origem deste
# painel precisa estar no CORS_ORIGINS de lá.
VITE_OPENAD_API_URL=http://localhost:3000

# ===== Banco (Postgres) =====
# Instância própria (ex.: recurso Postgres provisionado pelo Coolify). Sem
# pooler na frente numa instância única — as duas variáveis apontam pra
# mesma connection string. DIRECT_URL só é distinta se algum dia um pooler
# (PgBouncer) for colocado na frente do runtime.
DATABASE_URL="postgresql://usuario:senha@host-interno:5432/hub"
DIRECT_URL="postgresql://usuario:senha@host-interno:5432/hub"

# ===== Storage de imagens (MinIO / S3-compatível) =====
# Endpoint do MinIO (interno ao Coolify, ex. http://minio-service:9000),
# access/secret key de um usuário dedicado (não reaproveitar credencial de
# outra aplicação) e o bucket já criado. MINIO_PUBLIC_URL é a URL pública
# (via Traefik) usada pra montar o link salvo no banco, se divergir do
# endpoint interno.
MINIO_ENDPOINT=http://minio-service:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=hub-uploads
MINIO_PUBLIC_URL=

# ===== Autenticação (JWT próprio) =====
JWT_SECRET=troque-por-um-segredo-forte-de-32-bytes-ou-mais
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=604800

# ===== Integração com o OpenDriver (servidor-a-servidor) =====
# API do OpenDriver, usada só na EXCLUSÃO DE CONTA: a conta é a mesma nos dois
# serviços (public.users compartilhada), então cada um apaga o seu schema e pede
# ao outro que apague o dele. Sem esta URL a exclusão é RECUSADA (nunca feita
# pela metade). A chave em texto puro não fica aqui: crie uma em
# Admin -> Chaves de API com os escopos `account:read` e `account:purge` e
# cadastre o valor em Admin -> Integrações sob `Internal:AccountSyncKey`.
OPENDRIVER_API_URL=http://localhost:5100

# ===== API =====
PORT=5000
# Proxies reversos na frente da API: 1 = só Traefik; 2 = Cloudflare + Traefik.
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://localhost:5173
# URL pública do front, usada pra montar links em e-mail (verificação,
# redefinição de senha) e no redirect /r/indicacao. Se ficar vazia, cai no
# primeiro domínio de CORS_ORIGINS — em produção é opcional (já funciona
# certo via esse fallback), mas defina explicitamente se algum dia
# CORS_ORIGINS tiver mais de um domínio e o primeiro não for o principal.
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_AUTH_PERMIT=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# ===== Uploads =====
# Tamanho máximo (bytes) de imagem aceito no upload pro MinIO.
STORAGE_MAX_IMAGE_BYTES=5242880

# ===== Seed =====
# Seed:Enabled=true popula dados demo (parceiros/produtos/pedidos de exemplo).
# O admin abaixo é sempre garantido no boot, mesmo com SEED_ENABLED=false.
SEED_ENABLED=false
SEED_ADMIN_EMAIL=admin@opendriverhub.com
SEED_ADMIN_PASSWORD=Bababobo!@#

# ===== Pagamento =====
# Provider ativo: mock | mercadopago | asaas
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_REQUIRE_SIGNATURE=true
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# ===== Mercado Pago =====
# Credenciais também podem ser definidas em Admin -> Integrações (sobrepõem
# estas variáveis em runtime).
MercadoPago__AccessToken=
MercadoPago__PublicKey=
MercadoPago__WebhookSecret=

# ===== Asaas (gateway com split automático) =====
# Em produção use Environment=production.
Asaas__Environment=sandbox
Asaas__ApiKey=
Asaas__WebhookToken=
# CPF/CNPJ de teste usado no cliente Asaas em sandbox (PIX exige doc).
Asaas__DefaultCpfCnpj=

# ===== Link de indicação do afiliado (solar) =====
# Formulário (Formbricks) que o cliente final preenche. O redirect público
# /r/:code anexa ?affiliateCode={code} nessa URL.
AFFILIATE_FORM_URL=

# ===== Evolution API (WhatsApp self-hosted) =====
# Usado pelo afiliado solar pra parear o próprio WhatsApp e mandar propostas
# em PDF (whatsappConnectService.ts), e pela pesquisa de opinião pra mandar
# os vídeos (surveyWhatsappService.ts).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
