# Site do Hub (SPA) servido pelo nginx na porta 8080.
#
# Este arquivo é um *template*: a imagem oficial do nginx roda `envsubst` nele na partida do
# contêiner e grava o resultado em /etc/nginx/conf.d/default.conf. Só as variáveis QR_* abaixo
# são substituídas; as do próprio nginx ($uri, $arg_os…) ficam intactas.
#
# ============================================================================
# /qrcode-transfer — um QR Code único: a pessoa escolhe o app e vai para a loja certa
# ============================================================================
#
# O QR impresso aponta sempre para https://opendriver.com.br/qrcode-transfer, que abre um
# menu com os três apps (OpenDriver, OpenDriver Hub, OpenDriver Ads), cada um com uma
# descrição. Ao tocar numa opção o navegador pede /qrcode-transfer?app=<opcao> e o servidor
# olha o User-Agent e responde 302:
#
#   iPhone / iPad / iPod  ->  App Store      (QR_IOS_*_URL)
#   Android               ->  Google Play    (QR_ANDROID_*_URL)
#   qualquer outro        ->  a própria página (computador: escolher a loja; ou loja ainda
#                             sem link: "em breve")
#
# Feito no nginx, e não em JavaScript, de propósito: depois do toque o celular é
# redirecionado antes de baixar qualquer página ou script, sem tela intermediária.
#
# app = opendriver | hub | ads. `?os=ios` e `?os=android` forçam o sistema — usados pelos
# botões da página de reserva e para teste. Sem `app`, mostra o menu.
#
# Para publicar o app no iPhone: defina QR_IOS_URL (e/ou QR_IOS_HUB_URL, QR_IOS_ADS_URL) no
# Coolify (variáveis de ambiente do hub-frontend) com o link da App Store e faça redeploy.
# Enquanto estiver vazia, o iPhone vê "em breve" em vez de um link quebrado.

map "$arg_os:$http_user_agent" $qr_os {
    default                       other;
    "~*^ios:"                     ios;
    "~*^android:"                 android;
    "~*^:.*(iphone|ipad|ipod)"    ios;
    "~*^:.*android"               android;
}

map "$qr_os:$arg_app" $qr_destino {
    default                       "";
    "ios:opendriver"               "${QR_IOS_URL}";
    "android:opendriver"           "${QR_ANDROID_URL}";
    "ios:hub"                     "${QR_IOS_HUB_URL}";
    "android:hub"                 "${QR_ANDROID_HUB_URL}";
    "ios:ads"                     "${QR_IOS_ADS_URL}";
    "android:ads"                 "${QR_ANDROID_ADS_URL}";
}

server {
    listen 8080;
    root /usr/share/nginx/html;

    location = /qrcode-transfer {
        # O destino depende do aparelho: nada disto pode ser guardado em cache (nem pela
        # Cloudflare, que fica na frente do site).
        add_header Cache-Control "no-store" always;
        add_header Vary "User-Agent" always;
        add_header X-Robots-Tag "noindex, nofollow" always;

        if ($qr_destino != "") {
            return 302 $qr_destino;
        }
        # `rewrite … break` (e não try_files) mantém os cabeçalhos acima na página de reserva.
        rewrite ^ /qrcode-transfer.html break;
    }

    location = /qrcode-transfer/ {
        return 301 /qrcode-transfer$is_args$args;
    }

    # SPA fallback (React Router)
    location / {
        try_files $uri /index.html;
    }
}
